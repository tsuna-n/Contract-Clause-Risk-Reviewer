# Development configuration. Replace placeholders before live use.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/contract_risk_db
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Required settings even when development sign-in is used.
GOOGLE_OAUTH_API=replace-with-google-client-id
GOOGLE_KEY_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SESSION_SECRET_KEY=replace-with-independent-random-session-secret
JWT_SECRET_KEY=replace-with-independent-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ENABLE_DEV_LOGIN=false
PLAYBOOK_ADMIN_EMAILS=

# User-selected model; verified on ten CUAD fixtures.
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=replace-with-openrouter-api-key
LLM_OPENROUTER_PROVIDERS=[]
LLM_THINKING=disabled
REVIEW_CONCURRENCY=8
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1

# Must match stored playbook vectors.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIM=768
ENABLE_EMBEDDING_CACHE=true
EMBEDDING_CACHE_TTL_SECONDS=604800
ENABLE_HYBRID_RETRIEVAL=true
ENABLE_JUDGE=true
ENABLE_METADATA_EXTRACTION=true

# Reports retain clause text. No automatic PostgreSQL purge is scheduled.
REPORT_STORAGE=postgres
RETENTION_TTL_SECONDS=28800
# REPORT_RETENTION_DAYS=90
MAX_UPLOAD_BYTES=10485760
MAX_CLAUSES=300
